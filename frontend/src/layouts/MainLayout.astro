---
interface Props {
  title?: string;
  description?: string;
}

const { title = 'Cakranegara', description = 'Construction equipment & tool rental' } = Astro.props;
import '../styles/global.css';
import Navbar from '../pages/Navbar.astro';
import Footer from '../pages/Footer.astro';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="view-transition" content="same-origin" />
    <link rel="icon" type="image/png" href="/cakranegara-logo.png" />

    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; connect-src 'self' http://localhost:3000; object-src 'none'; base-uri 'self';"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Hanken+Grotesk:wght@400;600&family=Outfit:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap"
      rel="stylesheet"
    />

    <link rel="preload" as="image" href="/landingpage.png" />

    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    {Astro.url.pathname !== '/' && <Navbar currentPath={Astro.url.pathname} />}
    <slot />
    {Astro.url.pathname !== '/' && <Footer />}

    <script is:inline>
      function initAnimations() {
        var els = document.querySelectorAll('[data-animate]:not(.is-visible)');
        if (!els.length) return;

        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15 }
        );

        els.forEach(function (el) { io.observe(el); });
      }

      function initReveal() {
        var els = document.querySelectorAll('[data-reveal]:not(.revealed)');
        if (!els.length) return;

        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('revealed');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );

        els.forEach(function (el) { io.observe(el); });
      }

      document.addEventListener('DOMContentLoaded', function () { initAnimations(); initReveal(); });
      document.addEventListener('astro:page-load', function () { initAnimations(); initReveal(); });
    </script>
  </body>
</html>
