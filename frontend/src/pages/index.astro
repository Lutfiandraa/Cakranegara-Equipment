---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from './Navbar.astro';
import HeroSection from './HeroSection.astro';
import Ticker from './Ticker.astro';
import FleetGrid from '../components/FleetGrid.tsx';
import WhyUs from './WhyUs.astro';
import HowItWorks from './HowItWorks.astro';
import CTABanner from './CTABanner.astro';
import Footer from './Footer.astro';
---

<MainLayout title="Cakranegara Heavy Equipment">
  <Navbar currentPath={Astro.url.pathname} />
  <HeroSection />
  <Ticker />
  <FleetGrid client:load />
  <WhyUs />
  <HowItWorks />
  <CTABanner />
  <Footer />
</MainLayout>
