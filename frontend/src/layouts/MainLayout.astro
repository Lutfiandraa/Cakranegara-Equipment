---
interface Props {
  title?: string;
  description?: string;
}

const { title = 'Cakranegara', description = 'Construction equipment & tool rental' } = Astro.props;
import { ViewTransitions, fade } from 'astro:transitions';
import '../styles/global.css';
import Navbar from '../components/Navbar';
import Footer from '../components/Footer';
---

<!doctype html>
<html lang="id" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/cakranegara-logo.png" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; connect-src 'self' http://localhost:3000; object-src 'none'; base-uri 'self';"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <slot name="head" />
    <ViewTransitions />
  </head>
  <body>
    <Navbar client:load />
    <main transition:animate={fade({ duration: '0.35s' })}>
      <slot />
    </main>
    <Footer client:load />

    <script is:inline>
      function initReveal() {
        var els = document.querySelectorAll('[data-reveal]:not(.revealed)');
        if (!els.length) return;

        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('revealed');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );

        els.forEach(function (el) { io.observe(el); });
      }

      document.addEventListener('DOMContentLoaded', initReveal);
      document.addEventListener('astro:page-load', initReveal);
    </script>
  </body>
</html>
