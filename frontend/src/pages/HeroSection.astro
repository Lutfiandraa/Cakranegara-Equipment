---
---

<section
  class="relative min-h-[650px] flex items-end overflow-hidden"
  aria-label="Hero"
>
  <video
    autoplay
    loop
    muted
    playsinline
    class="absolute inset-0 w-full h-full object-cover z-0"
  >
    <source src="/caterpillar793.mp4" type="video/mp4" />
  </video>

  <div class="absolute inset-0 bg-gradient-to-t from-equipment-black via-equipment-black/70 to-equipment-black/30 z-0" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-gradient-to-r from-equipment-black/60 to-transparent z-0" aria-hidden="true"></div>

  <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 md:pb-24">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-8 md:gap-12">
      <div class="max-w-2xl">
        <p
          data-animate
          data-delay="0"
          class="fade-in font-display uppercase tracking-[0.3em] text-equipment-gold text-xs mb-4"
        >
          Solusi Rental Alat Berat Terpercaya
        </p>

        <h1
          data-animate
          data-delay="100"
          class="fade-up font-display font-bold text-equipment-text-primary text-4xl sm:text-5xl md:text-6xl lg:text-7xl uppercase leading-[0.95] mb-6"
        >
          Cakranegara<br />
          <span class="text-equipment-gold">Heavy Equipment</span>
        </h1>

        <p
          data-animate
          data-delay="200"
          class="fade-up font-body text-equipment-text-muted text-base md:text-lg max-w-lg mb-8 leading-relaxed"
        >
          Penyedia armada alat berat pertambangan dan konstruksi dengan standar keselamatan tertinggi dan dukungan teknis 24/7.
        </p>

        <div data-animate data-delay="300" class="fade-up flex flex-wrap gap-4">
          <a href="/company" class="btn-primary">
            Hubungi Kami
          </a>
        </div>
      </div>


    </div>
  </div>
</section>
