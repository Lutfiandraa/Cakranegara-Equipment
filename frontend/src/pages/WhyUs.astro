---
const stats = [
  { icon: 'engineering', value: '24/7', label: 'Dukungan Teknis', description: 'Support tanpa henti' },
  { icon: 'shield', value: 'ISO', label: 'Standar Safety', description: 'Keselamatan terjamin' },
  { icon: 'speed', value: '98%', label: 'Uptime', description: 'Keandalan armada' },
];
---

<section class="py-16 md:py-24 bg-equipment-surface border-y border-white/5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-0 md:divide-x md:divide-equipment-gold/20">
      {stats.map((stat, i) => (
        <div
          data-animate
          data-delay={`${i * 100}`}
          class="fade-up text-center px-4 md:px-8"
        >
          <span class="material-symbols-outlined text-equipment-gold text-3xl mb-3 block">
            {stat.icon}
          </span>
          <p class="font-display font-bold text-equipment-text-primary text-2xl md:text-3xl uppercase">
            {stat.value}
          </p>
          <p class="font-display uppercase tracking-widest text-equipment-gold text-xs mt-2">
            {stat.label}
          </p>
          <p class="font-body text-equipment-text-muted text-xs mt-1">
            {stat.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
